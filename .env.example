# Copia este archivo a .env y completa con tus datos reales.
# NUNCA subas el archivo .env real a git (ya está en .gitignore).

# URL base de tu instancia Odoo (sin slash final), ej: https://miempresa.odoo.com
ODOO_URL=https://tuinstancia.odoo.com

# Nombre de la base de datos Odoo
ODOO_DB=nombre_de_tu_bd

# Usuario (email o login) con el que se autentica el conector
ODOO_USERNAME=usuario@tuempresa.com

# API Key generada en Odoo: Ajustes > Usuarios > (tu usuario) > pestaña
# "Seguridad de la cuenta" > Claves API > Nueva clave API.
# Recomendado sobre password: revocable sin cambiar tu contraseña de login.
ODOO_API_KEY=tu_api_key_aqui

# Alternativa a ODOO_API_KEY: password del usuario. Usa solo una de las dos
# (si ambas están presentes, se prioriza ODOO_API_KEY). Menos seguro que una
# API key dedicada porque revocarla implica cambiar tu contraseña de login.
ODOO_PASSWORD=

# Opcional: timeout en segundos para las llamadas XML-RPC (default 30)
ODOO_TIMEOUT=30

# Opcional: poner en "false" SOLO para instancias locales/dev con certificado
# SSL self-signed (ej. https://localhost:8090). NUNCA desactivar contra producción.
ODOO_VERIFY_SSL=true
